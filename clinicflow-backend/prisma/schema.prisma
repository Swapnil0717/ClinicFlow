generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum SlotType {
  CUSTOM
  RECURRING
}

enum SlotMode {
  STREAM
  WAVE
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

//////////////////////
// USER
//////////////////////

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  role      Role

  // 🔥 RELATIONS
  doctor    Doctor?

  clinicId  String?
  clinic    Clinic? @relation("ClinicUsers", fields: [clinicId], references: [id], onDelete: SetNull)

  ownedClinic Clinic? @relation("ClinicOwner")

  appointments Appointment[] @relation("PatientAppointments")

  // 🔐 AUTH
  isEmailVerified      Boolean  @default(false)
  emailVerifyToken     String?
  resetPasswordToken   String?
  resetPasswordExpiry  DateTime?

  provider    AuthProvider @default(EMAIL)
  providerId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

//////////////////////
// CLINIC (TENANT CORE)
//////////////////////

model Clinic {
  id        String   @id @default(uuid())
  name      String
  address   String

  // 🔥 OWNER
  ownerId   String   @unique
  owner     User     @relation("ClinicOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // 🔥 RELATIONS
  users     User[]   @relation("ClinicUsers")
  doctors   Doctor[]

  slots        Slot[]
  subSlots     SubSlot[]
  appointments Appointment[]
  recurringSlots RecurringSlot[]

  createdAt DateTime @default(now())
}

//////////////////////
// DOCTOR
//////////////////////

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique

  specialization  String
  experience      Int
  consultationFee Float

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // RELATIONS
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots        Slot[]
  recurringSlots RecurringSlot[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

//////////////////////
// RECURRING SLOT
//////////////////////

model RecurringSlot {
  id        String   @id @default(uuid())
  doctorId  String
  clinicId  String

  daysOfWeek Int[]

  startTime DateTime
  endTime   DateTime

  slotDuration Int
  mode      SlotMode
  maxPatientsPerSubSlot Int

  validFrom DateTime
  validTill DateTime

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([doctorId, clinicId])
}

//////////////////////
// SLOT
//////////////////////

model Slot {
  id        String   @id @default(uuid())
  doctorId  String
  clinicId  String

  date      DateTime
  startTime DateTime
  endTime   DateTime

  slotDuration Int
  type      SlotType
  isOverride Boolean @default(false)

  mode      SlotMode
  maxPatientsPerSubSlot Int

  isActive  Boolean @default(true)

  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  subSlots SubSlot[]

  createdAt DateTime @default(now())

  @@index([clinicId, doctorId, date])
  @@unique([doctorId, date, startTime])
}

//////////////////////
// SUB SLOT
//////////////////////

model SubSlot {
  id        String   @id @default(uuid())
  slotId    String
  clinicId  String

  startTime DateTime
  endTime   DateTime

  currentBookings Int @default(0)
  maxBookings     Int

  isFull Boolean @default(false)

  slot   Slot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())

  @@index([clinicId, slotId])
}

//////////////////////
// APPOINTMENT
//////////////////////

model Appointment {
  id        String   @id @default(uuid())

  patientId String
  doctorId  String
  subSlotId String
  clinicId  String

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(BOOKED)

  patient User   @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  subSlot SubSlot @relation(fields: [subSlotId], references: [id], onDelete: Cascade)
  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, doctorId, startTime])
  @@index([patientId])
  @@unique([patientId, subSlotId])
}
