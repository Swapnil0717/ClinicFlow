generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid())
  name                  String
  email                 String   @unique
  password              String?
  role                  Role     @default(PATIENT)

  clinicId              String?
  clinic                Clinic?  @relation(fields: [clinicId], references: [id])

  isEmailVerified       Boolean  @default(false)
  emailVerifyToken      String?
  emailVerifyExpiry     DateTime?

  resetPasswordToken    String?
  resetPasswordExpiry   DateTime?

  provider              String?
  providerId            String?

  refreshToken          String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  patient               Patient?
  doctor                Doctor?
  clinicsOwned          Clinic[] @relation("ClinicOwner")

  @@index([emailVerifyToken])
  @@index([resetPasswordToken])
}

model Patient {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])

  appointments Appointment[]
}

model Doctor {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])

  clinicId  String
  clinic    Clinic @relation(fields: [clinicId], references: [id])

  isVerified Boolean @default(false)
  rejected   Boolean @default(false)
  rejectionReason String?

  specialization String?
  experience     Int?

  appointments Appointment[]
  slots        Slot[]
  recurringSlots RecurringSlot[]
}

model Clinic {
  id        String @id @default(uuid())
  name      String
  address   String

  isVerified Boolean @default(false)

  ownerId   String
  owner     User @relation("ClinicOwner", fields: [ownerId], references: [id])

  users     User[]
  doctors   Doctor[]

  rejected   Boolean @default(false)        
  rejectionReason String? 

  createdAt DateTime @default(now())

  appointments Appointment[]
  slots        Slot[]
  subSlots     SubSlot[]
  recurringSlots RecurringSlot[]
}

//////////////////////////////////////
// SLOT SYSTEM
//////////////////////////////////////

model Slot {
  id        String @id @default(uuid())

  clinicId  String
  doctorId  String

  clinic    Clinic @relation(fields: [clinicId], references: [id])
  doctor    Doctor @relation(fields: [doctorId], references: [id])

  date      DateTime
  startTime DateTime
  endTime   DateTime

  slotDuration Int

  type      SlotType
  isOverride Boolean @default(false)
  isActive   Boolean @default(true)

  mode      SlotMode
  maxPatientsPerSubSlot Int

  subSlots  SubSlot[]
}

model SubSlot {
  id        String @id @default(uuid())

  slotId    String
  clinicId  String

  slot      Slot   @relation(fields: [slotId], references: [id])
  clinic    Clinic @relation(fields: [clinicId], references: [id])

  startTime DateTime
  endTime   DateTime

  currentBookings Int @default(0)
  maxBookings     Int

  isFull Boolean @default(false)

  appointments Appointment[]
}

model RecurringSlot {
  id        String @id @default(uuid())

  clinicId  String
  doctorId  String

  clinic    Clinic @relation(fields: [clinicId], references: [id])
  doctor    Doctor @relation(fields: [doctorId], references: [id])

  daysOfWeek Int[]

  startTime DateTime
  endTime   DateTime

  slotDuration Int

  mode      SlotMode
  maxPatientsPerSubSlot Int

  validFrom DateTime
  validTill DateTime
}

//////////////////////////////////////
// APPOINTMENT (UPDATED)
//////////////////////////////////////

model Appointment {
  id        String   @id @default(uuid())

  patientId String
  doctorId  String
  clinicId  String
  subSlotId String

  patient   Patient @relation(fields: [patientId], references: [id])
  doctor    Doctor  @relation(fields: [doctorId], references: [id])
  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  subSlot   SubSlot @relation(fields: [subSlotId], references: [id])

  startTime DateTime
  endTime   DateTime

  status    AppointmentStatus @default(CONFIRMED)

  cancelledBy Role?        // 🔥 NEW
  cancelledAt DateTime?    // 🔥 NEW

  createdAt DateTime @default(now())
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
}

enum SlotType {
  RECURRING
  CUSTOM
}

enum SlotMode {
  STREAM
  WAVE
}